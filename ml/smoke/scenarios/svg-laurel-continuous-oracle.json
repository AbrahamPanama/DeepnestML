{
  "name": "svg-laurel-continuous-oracle",
  "description": "Slow reproducibility oracle for the bounded crossed-laurel continuous-compaction gate. Not part of the default battery.",
  "input": "ml/examples/laurel-two-crossed.svg",
  "sourceFormat": "svg",
  "outputFormat": "svg",
  "timeoutMs": 90000,
  "timeBudgetSec": 35,
  "expectedNonCanonicalNfpLookups": 0,
  "configOverrides": {
    "placementType": "gravity",
    "mergeLines": false,
    "processHoles": false,
    "populationSize": 1,
    "mutationRate": 0,
    "threads": 1,
    "rotations": 1,
    "adaptiveRotations": false,
    "localRefinement": true,
    "localRefinementEngine": "smart",
    "localRefinementBudgetMs": 30000,
    "localRefinementContinuous": true,
    "continuousRefinementBudgetMs": 30000,
    "continuousRefinementMaxDeltaDeg": 45,
    "continuousRefinementCoarseStepDeg": 2,
    "continuousRefinementRefineStepDeg": 0.5,
    "continuousRefinementFineStepDeg": 0.1,
    "continuousRefinementProxyPoints": 24,
    "continuousRefinementContactCap": 192,
    "continuousRefinementPosesPerAngle": 8,
    "continuousRefinementFinalists": 20,
    "continuousRefinementMaxPairs": 1,
    "curveTolerance": 2
  }
}
