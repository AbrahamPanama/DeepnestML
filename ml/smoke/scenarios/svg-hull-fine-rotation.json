{
  "name": "svg-hull-fine-rotation",
  "description": "Default-off fine-rotation snugging smoke path: smart local refinement, mergeLines disabled, exact final gate for off-grid rotations.",
  "input": "ml/examples/comb-branches.svg",
  "sourceFormat": "svg",
  "outputFormat": "svg",
  "timeoutMs": 90000,
  "timeBudgetSec": 10,
  "configOverrides": {
    "placementType": "convexhull",
    "mergeLines": false,
    "populationSize": 8,
    "threads": 2,
    "rotations": 4,
    "localRefinement": true,
    "localRefinementEngine": "smart",
    "localRefinementBudgetMs": 3500,
    "localRefinementFineRotation": true,
    "fineRotationMaxTargets": 4
  }
}
